   {<<"optional">>,false},
   {<<"repository">>,<<"hexpm">>},
   {<<"requirement">>,<<"~> 3.1">>}],
  [{<<"app">>,<<"postgrex">>},
   {<<"name">>,<<"postgrex">>},
   {<<"optional">>,true},
   {<<"repository">>,<<"hexpm">>},
   {<<"requirement">>,<<"~> 0.13">>}]]}.
{<<"version">>,<<"3.0.0">>}.
