{<<"app">>,<<"guardian_db">>}.
{<<"build_tools">>,[<<"mix">>]}.
{<<"description">>,<<"DB tracking for token validity">>}.
{<<"elixir">>,<<"~> 1.4 or ~> 1.5">>}.
{<<"files">>,
 [<<"lib">>,<<"lib/guardian">>,<<"lib/guardian/db">>,
  <<"lib/guardian/db/adapter.ex">>,<<"lib/guardian/db/ecto_adapter.ex">>,
  <<"lib/guardian/db/token.ex">>,<<"lib/guardian/db/sweeper.ex">>,
  <<"lib/guardian/db/ets_adapter.ex">>,<<"lib/guardian/db.ex">>,<<"lib/mix">>,
  <<"lib/mix/tasks">>,<<"lib/mix/tasks/guardian_db.gen.migration.ex">>,
  <<"CHANGELOG.md">>,<<"LICENSE">>,<<"mix.exs">>,<<"README.md">>,
  <<"priv/templates">>,<<"priv/templates/migration.exs.eex">>]}.
{<<"licenses">>,[<<"MIT">>]}.
{<<"links">>,[{<<"GitHub">>,<<"https://github.com/ueberauth/guardian_db">>}]}.
{<<"name">>,<<"guardian_db">>}.
{<<"requirements">>,
